#!/bin/sh /etc/rc.common
START=99
STOP=09
USE_PROCD=1
start_service() {
 procd_open_instance
 procd_set_param command /usr/libexec/singbox-ui run
 procd_set_param respawn 3600 10 5
 procd_set_param stdout 1
 procd_set_param stderr 1
 procd_set_param term_timeout 20
 procd_close_instance
}
stop_service() {
 /usr/libexec/singbox-ui routes-off
}
