{
 "luci-app-singbox-ui": {
  "description":"Configure and control minimal sing-box",
  "read": {
   "uci":["singboxui"],
   "ubus":{"file":["read","exec"]},
   "file":{
    "/usr/libexec/singbox-ui":["exec"],
    "/etc/singbox-ui/config.json":["read"],
    "/etc/singbox-ui/config.pending.json":["read"]
   }
  },
  "write": {
   "uci":["singboxui"],
   "ubus":{"file":["write","exec"]},
   "file":{
    "/usr/libexec/singbox-ui":["exec"],
    "/etc/singbox-ui/config.pending.json":["write"],
    "/etc/singbox-ui/config.check.json":["write"]
   }
  }
 }
}
